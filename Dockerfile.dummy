# SD3.5 Large LoRA Training System - RunPod Development Container
FROM runpod/pytorch:2.2.1-py3.10-cuda12.1.1-devel-ubuntu22.04

# Environment variables for SD3.5 LoRA system
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV WORKSPACE_DIR=/workspace
ENV POETRY_CACHE_DIR=/workspace/poetry_cache
ENV POETRY_VENV_PATH=/workspace/poetry_venvs
ENV HF_HOME=/workspace/huggingface_cache
ENV HUGGINGFACE_HUB_CACHE=/workspace/huggingface_cache

# Install system dependencies
RUN apt update && apt install -y \
    git \
    curl \
    wget \
    nano \
    vim \
    htop \
    tmux \
    screen \
    redis-server \
    sqlite3 \
    ffmpeg \
    libsm6 \
    libxext6 \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

# Install and configure Poetry
RUN pip install --upgrade pip && pip install poetry
RUN poetry config virtualenvs.path /workspace/poetry_venvs
RUN poetry config cache-dir /workspace/poetry_cache

# Create directory structure for SD3.5 LoRA system
RUN mkdir -p \
    /workspace/sd3-large-docker \
    /workspace/huggingface_cache \
    /workspace/poetry_cache \
    /workspace/poetry_venvs \
    /workspace/training_data \
    /workspace/models \
    /workspace/generated_images \
    /workspace/logs

# Set up SSH for RunPod access
RUN mkdir -p /var/run/sshd
RUN echo 'root:runpod' | chpasswd
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

WORKDIR /workspace/sd3-large-docker

# Copy project files for dependency installation
COPY pyproject.toml poetry.lock* /workspace/sd3-large-docker/
RUN poetry install --only main --no-interaction --no-ansi

# Copy the entire project
COPY . /workspace/sd3-large-docker/

# Make scripts executable
RUN chmod +x /workspace/sd3-large-docker/dummy_start.sh
RUN chmod +x /workspace/sd3-large-docker/setup_runpod.sh 2>/dev/null || true

# Expose ports for SD3.5 API and development
EXPOSE 22 5555 6006 8000 8080 8888

# Use startup script that initializes everything
CMD ["/workspace/sd3-large-docker/dummy_start.sh"]