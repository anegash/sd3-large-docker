{
  "title": "Stable Diffusion 3.5 Large",
  "description": "High-quality text-to-image generation using Stable Diffusion 3.5 Large model with professional-grade output and advanced prompt understanding.",
  "type": "serverless",
  "category": "image",
  "image": "stabilityai/sd3-large-api:latest",
  "runsOn": "GPU",
  "containerDiskInGb": 50,
  "env": [
    {
      "key": "HUGGINGFACE_TOKEN",
      "value": "",
      "description": "HuggingFace token required for accessing gated SD3.5 Large model"
    }
  ],
  "presets": [
    {
      "name": "High Quality",
      "description": "Best quality settings for detailed images",
      "inputs": {
        "steps": 30,
        "guidance": 7.5,
        "width": 1024,
        "height": 1024
      }
    },
    {
      "name": "Fast Generation",
      "description": "Optimized for speed while maintaining good quality",
      "inputs": {
        "steps": 20,
        "guidance": 5.0,
        "width": 1024,
        "height": 1024
      }
    },
    {
      "name": "Portrait",
      "description": "Optimized aspect ratio for portraits",
      "inputs": {
        "steps": 25,
        "guidance": 7.0,
        "width": 768,
        "height": 1024
      }
    },
    {
      "name": "Landscape",
      "description": "Optimized aspect ratio for landscapes",
      "inputs": {
        "steps": 25,
        "guidance": 7.0,
        "width": 1024,
        "height": 768
      }
    }
  ],
  "inputs": {
    "prompt": {
      "type": "string",
      "description": "Text description of the image to generate",
      "required": true,
      "placeholder": "a beautiful sunset over mountains"
    },
    "steps": {
      "type": "number",
      "description": "Number of denoising steps (higher = better quality, slower)",
      "default": 20,
      "min": 10,
      "max": 50
    },
    "guidance": {
      "type": "number",
      "description": "Guidance scale (higher = more adherence to prompt)",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0
    },
    "width": {
      "type": "number",
      "description": "Image width in pixels",
      "default": 1024,
      "min": 512,
      "max": 2048
    },
    "height": {
      "type": "number",
      "description": "Image height in pixels", 
      "default": 1024,
      "min": 512,
      "max": 2048
    },
    "seed": {
      "type": "number",
      "description": "Random seed for reproducible results (optional)",
      "required": false
    }
  },
  "outputs": {
    "image": {
      "type": "string",
      "description": "Generated image as base64 encoded PNG"
    },
    "seed": {
      "type": "number", 
      "description": "Seed used for generation"
    },
    "format": {
      "type": "string",
      "description": "Output image format"
    }
  },
  "minimumGpuMemoryGb": 16,
  "cudaVersions": ["11.8", "12.1", "12.2"]
}